# ===================================================================
# EditorConfig - Padrões de Código para o Projeto Regalaya
# ===================================================================
# https://editorconfig.org
# ===================================================================

# Indica que este é o arquivo de configuração principal
root = true

# ============================
# Arquivos Genéricos
# ============================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ============================
# Markdown
# ============================
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ============================
# YAML
# ============================
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# ============================
# JSON
# ============================
[*.json]
indent_style = space
indent_size = 2

# ============================
# Dockerfile
# ============================
[Dockerfile]
indent_style = space
indent_size = 4

# ============================
# Shell Scripts
# ============================
[*.sh]
indent_style = space
indent_size = 2
shell_variant = bash

# ============================
# Java
# ============================
[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# ============================
# TypeScript / JavaScript
# ============================
[*.{ts,tsx,js,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# ============================
# TypeScript/JS Config
# ============================
[*.config.{js,ts,mjs}]
indent_style = space
indent_size = 2

# ============================
# CSS / SCSS
# ============================
[*.{css,scss,sass}]
indent_style = space
indent_size = 2

# ============================
# HTML / XML
# ============================
[*.{html,xml}]
indent_style = space
indent_size = 2

# ============================
# Properties
# ============================
[*.properties]
indent_style = space
indent_size = 2
