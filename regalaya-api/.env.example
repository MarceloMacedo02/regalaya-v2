# ===================================================================
# REGALAYA API - Variáveis de Ambiente
# ===================================================================
# Copie este arquivo para .env na raiz do projeto regalaya-api
# cp .env.example .env
# ===================================================================

# ===================================================================
# Database Configuration
# ===================================================================
# Credenciais do banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=regalaya_dev
DB_USERNAME=regalaya
DB_PASSWORD=postgres

# ===================================================================
# JWT Authentication
# ===================================================================
# IMPORTANTE: Altere esta chave em produção!
# Use uma chave de no mínimo 256 bits (64 caracteres)
# Gere uma nova: openssl rand -base64 64
JWT_SECRET=sua-chave-secreta-muito-longa-para-assinatura-jwt-minimo-256-bits-long-enough-for-hs512

# Tempo de expiração do token (em segundos)
JWT_EXPIRATION=900

# Tempo de expiração do refresh token (em segundos) - 7 dias
JWT_REFRESH_EXPIRATION=604800

# ===================================================================
# Email Configuration (Opcional)
# ===================================================================
# Para desenvolvimento, use Mailpit (já configurado no docker-compose)
EMAIL_FROM=noreply@regalaya.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=seu-email@gmail.com
EMAIL_PASSWORD=sua-senha-de-app

# ===================================================================
# CORS Configuration
# ===================================================================
# Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ===================================================================
# Spring Profiles
# ===================================================================
# dev: perfil de desenvolvimento
# docker: perfil para Docker
# prod: perfil de produção
SPRING_PROFILES_ACTIVE=dev,docker

# ===================================================================
# AWS / LocalStack Configuration
# ===================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
AWS_S3_BUCKET=regalaya-uploads

# ===================================================================
# Redis Configuration
# ===================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================================================================
# Rate Limiting
# ===================================================================
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_ENABLED=true

# ===================================================================
# API Configuration
# ===================================================================
API_BASE_URL=http://localhost:8080/api/v1
API_CONTEXT_PATH=/api

# ===================================================================
# Logging
# ===================================================================
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} - %msg%n

# ===================================================================
# Management & Actuator
# ===================================================================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ===================================================================
# Upload Configuration
# ===================================================================
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ===================================================================
# WhatsApp Configuration (Futuro)
# ===================================================================
# WHATSAPP_API_URL=https://graph.facebook.com/v18.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# ===================================================================
# Mercado Pago Configuration (Futuro)
# ===================================================================
# MERCADO_PAGO_ACCESS_TOKEN=
# MERCADO_PAGO_PUBLIC_KEY=
# ===================================================================
# AI / OpenRouter / Ollama Configuration
# ===================================================================
# Para OpenRouter Cloud (Padrão):
# OPENROUTER_API_KEY=seu-api-key-aqui
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Para Ollama local:
# OPENROUTER_API_KEY=ollama
# OPENROUTER_MODEL=gpt-oss:20b
# OPENROUTER_BASE_URL=http://localhost:11434/v1
