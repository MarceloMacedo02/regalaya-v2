# Lombok Configuration
# https://projectlombok.org/features/configuration

# Configuração para gerar getters/setters com nomes Java padrão
lombok.addLombokGeneratedAnnotation = true

# Configuração para builder
lombok.anyConstructor.addConstructorProperties = true

# Configuração para EqualsAndHashCode
lombok.equalsAndHashCode.callSuper = skip

# PROIBIR @Data em entidades JPA (problemas de performance e recursão Hibernate)
# Use @Getter + @Setter + @ToString(exclude={...}) + @EqualsAndHashCode(of="id") manualmente
lombok.data.flagUsage = warning
