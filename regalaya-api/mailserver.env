# ===================================================================
# REGALAYA MAILSERVER - Docker Mailserver Configuration
# ===================================================================

# Domain and hostname
DOMAINNAME=regalaya.local

# SSL/TLS - Disabled for local development
SSL_TYPE=empty

# Disable heavy services for development
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_FAIL2BAN=0

# Permit Docker network containers to relay
PERMIT_DOCKER=network

# Spoof protection disabled for development
SPOOF_PROTECTION=0

# Postmaster address
POSTMASTER_ADDRESS=postmaster@regalaya.local
